# Backend Environment Variables Example Configuration
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/donateconnect
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# JWT Secret (Must be at least 256-bit / 32 characters long for HS256)
JWT_SECRET=donateConnectSecretKeyMustBeAtLeast32BytesLongForHS256Security!
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local File Storage Uploads Directory
UPLOAD_DIR=uploads/
